{
  "name": "database-mcp",
  "version": "1.0.0",
  "description": "Generic read-only database MCP server",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "healthcheck": "node dist/healthcheck.js",
    "verify-permissions": "node dist/verify-permissions.js",
    "generate-config": "node scripts/generate-mcp-config.mjs",
    "docker:build": "docker compose build database-mcp",
    "docker:ps": "docker ps -a --filter label=com.database-mcp.stack=database-mcp",
    "docker:clean": "docker rm $(docker ps -aq --filter label=com.database-mcp.stack=database-mcp --filter status=exited --filter status=created)"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "dotenv": "^17.4.2",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
