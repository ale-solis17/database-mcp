# ─────────────────────────────────────────────────────────────
# Database MCP Server — example configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

### DATABASE CONFIGURATION ###
# Engine to connect to. Only "postgres" is implemented today.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
# IMPORTANT: use a DEDICATED read-only user, never your application/owner user.
# See docs/security.md for how to create `mcp_readonly`.
DB_USER=
DB_PASSWORD=
# Set to true for managed providers (Neon, RDS, etc.). Auto-enabled for non-local hosts.
DB_SSL=

### MCP SERVER ###
MCP_NAME=database-mcp
MCP_VERSION=1.0.0

### SAFETY LIMITS ###
# Hard cap on rows returned to the AI.
MAX_ROWS=1000
# Per-query timeout in milliseconds.
QUERY_TIMEOUT_MS=10000
# Maximum serialized result size in megabytes.
MAX_RESULT_SIZE_MB=10
