# ─────────────────────────────────────────────────────────────
# Database MCP Server — example configuration
# Copy this file to `.env` and fill it in. NEVER commit `.env`.
#
# Database connections do NOT live here any more. They live in databases.json
# (copy databases.example.json, or run ./setup.sh). This file holds only the
# global settings plus the secrets that databases.json references as ${VAR}.
# ─────────────────────────────────────────────────────────────

### PROFILE SECRETS ###
# One entry per ${VAR} used in databases.json. The setup script writes these
# for you and names them MCPDB_<PROFILE>_PASSWORD or MCPDB_<PROFILE>_URL.
# Write values unquoted and on a single line. A value containing `#`, quotes or
# leading/trailing spaces is read differently by Node and by `docker --env-file`
# — re-run setup rather than hand-editing such a value.
MCPDB_NEON_PASSWORD=
MCPDB_LOCAL_URL=

### MCP SERVER ###
MCP_NAME=database-mcp
MCP_VERSION=1.0.0

### SAFETY LIMITS ###
# Applied to every profile.
# Hard cap on rows returned to the AI.
MAX_ROWS=1000
# Per-query timeout in milliseconds.
QUERY_TIMEOUT_MS=10000
# Maximum serialized result size in megabytes.
MAX_RESULT_SIZE_MB=10

### LOGGING ###
# debug | info | warn | error. Logs always go to stderr, never stdout.
LOG_LEVEL=info

### PATH OVERRIDES (optional) ###
# Only needed when the files are not next to the server's package root, e.g.
# when databases.json is bind-mounted into a container at another path.
# DATABASES_CONFIG=/absolute/path/to/databases.json
# DATABASE_MCP_ENV_FILE=/absolute/path/to/.env
